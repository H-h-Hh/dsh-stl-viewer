{
  "name": "dsh-stl-viewer",
  "version": "1.6.2",
  "description": "STL / STEP preview in the DSH side card: a hand-rolled WebGL orbit viewer (left-drag rotate, wheel zoom, right-drag pan) that reads STL directly and tessellates STEP, IGES and BREP through OpenCascade in a host worker, with Bambu-style measuring that snaps to vertices, edges, faces and circles, a corner panel that reads out diameters, and volume / surface / view presets / wireframe / PNG export.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "stl",
    "step",
    "iges",
    "brep",
    "opencascade",
    "3d",
    "viewer",
    "webgl",
    "better-sidebar",
    "cad"
  ],
  "author": "H-h-Hh",
  "license": "MIT",
  "homepage": "https://github.com/H-h-Hh/dsh-stl-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H-h-Hh/dsh-stl-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/H-h-Hh/dsh-stl-viewer/issues"
  },
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/smoke.cjs",
    "check": "node --check lib/client.js && node test/smoke.cjs && node test/host.mjs"
  },
  "dependencies": {
    "occt-import-js": "^0.0.23"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.3": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    },
    "client": {
      "platform": "web"
    }
  }
}
